node_modules/
dist/
*.log

# Local credentials and runtime state — never commit
.env
.env.local
state/

# Live config copies (only the *.example.yaml files are tracked)
config/*.yaml
!config/*.example.yaml
config/*.local.yaml

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local agent/worktree state
.claude/

# Derived code index — rebuilt by `codegraph init -i` in <1s
.codegraph/

# Generated review attachments
docs/*.pdf
.env.bak

# Playwright MCP session scratch
.playwright-mcp/

# SDD workspace scratch
.superpowers/

# --- core/ (the merged gc_advisor tree) ---
# Belt-and-braces with core/.gitignore: these MUST hold even if the nested
# file is ever edited. Student-record derivatives never enter git (G3).
core/.venv/
core/db/gc_advisor.db
core/docs/degreeworks/
core/docs/*.pdf
core/**/__pycache__/
core/**/*.pyc
core/**/*.egg-info/
core/.pytest_cache/
core/.playwright-mcp/
core/.superpowers/
