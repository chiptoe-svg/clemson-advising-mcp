# Copy to .env in the repo root and fill in. NEVER commit it — .env is
# gitignored, holds the only copy of each bearer token, and cannot be recovered
# from git. Back it up before editing it.

# --- Transport -------------------------------------------------------------
# "http" to serve over the network (behind the reverse proxy). "stdio" is the
# local/dev default and is what a client that launches the server directly uses.
MCP_TRANSPORT=http

# --- Bind ------------------------------------------------------------------
# KEEP THESE ON LOOPBACK. Campus reachability comes from the reverse proxy
# (deploy/Caddyfile.example). The MCP HTTP transport performs no Host/Origin
# validation, so a 0.0.0.0 bind makes the bearer token the only gate.
MCP_PUBLIC_HTTP_HOST=127.0.0.1
MCP_PUBLIC_HTTP_PORT=8766
MCP_CATALOG_HTTP_HOST=127.0.0.1
MCP_CATALOG_HTTP_PORT=8767

# --- Attested backend ------------------------------------------------------
# SET THESE EXPLICITLY. Unset, they attest "openai_api", and the usage ledger
# will name a destination this deployment does not use. The value must be a
# backend that policy/action-policy.yaml authorizes for the "public" data class.
MCP_PUBLIC_AUTH_TOKEN_PROVIDER=clemson_hosted
MCP_CATALOG_AUTH_TOKEN_PROVIDER=clemson_hosted

# --- Shared fallback tokens (OPTIONAL — prefer per-consumer tokens) ---------
# A server accepts one token from here IN ADDITION to its consumer registry.
# It exists as a migration path and shows up in the ledger as "env-token", so
# its traffic is at least distinguishable. In a deployment serving other
# people's agents it should be left UNSET and every caller paired with
# `npm run mcp:pair`, because one shared token makes the ledger meaningless.
#
# With no token here AND an empty registry there are zero consumers and the
# server refuses to start rather than serving open.
# MCP_PUBLIC_AUTH_TOKEN=
# MCP_CATALOG_AUTH_TOKEN=

# --- Trusted reverse proxies -----------------------------------------------
# Whose X-Forwarded-For this server believes. The default (loopback) is correct
# when the proxy runs on this same host, which is the recommended layout. Set it
# only for a proxy elsewhere, and set it to the PROXY's address, never a client
# range. Get this wrong and every caller is logged as the proxy: the per-source
# throttle collapses into one shared bucket and the audit log attributes nothing.
# MCP_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
