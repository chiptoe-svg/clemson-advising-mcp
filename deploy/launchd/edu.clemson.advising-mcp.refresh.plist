<?xml version="1.0" encoding="UTF-8"?>
<!--
  Banner class-schedule refresh: the nightly, plus hourly weekday refreshes of
  the registering term during a registration window.

  This job is what stands between the service and its most common failure mode:
  the servers keep answering, confidently, from a snapshot that stopped being
  true. Nothing breaks when it stops running — which is exactly why its absence
  is hard to notice. Alert on snapshot age, not on this job's exit status.

  New terms are discovered automatically from Banner; "(View Only)" terms are
  skipped. Inside a registration window only the window's term is refreshed. Placeholders are filled in by deploy/install.sh.

  It does NOT rebuild the curriculum catalog, which changes annually and is
  built elsewhere — see docs/operations.md, "Deploying to a new box".
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>edu.clemson.advising-mcp.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>NPM_PATH</string>
    <string>run</string>
    <string>clemson:refresh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Trust OpenSSL's CA bundle (Homebrew openssl@3/cert.pem), not Node's
         compiled-in roots. 2026-10-21: node 22.22.2's bundled store still
         trusts the compromised "emSign ECC Root CA - G3" (removed upstream
         in 22.23.4); the Homebrew bundle does not. Drop this once node@22
         is at 22.23.4 or later. -->
    <key>NODE_OPTIONS</key>
    <string>--use-openssl-ca</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>HOME_PATH</string>
  </dict>

  <!-- 05:00 and hourly 08:00-17:00, every day. scripts/clemson-refresh.ts
       (src/refresh-plan.ts) decides what each firing does: the first run of
       the Eastern day is the nightly; inside a registration window
       (deploy/registration-windows.json) weekday firings refresh that term;
       any other firing exits at once. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>HOME_PATH/Library/Logs/advising-mcp.refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/Library/Logs/advising-mcp.refresh.err.log</string>
</dict>
</plist>
