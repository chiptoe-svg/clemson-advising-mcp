<?xml version="1.0" encoding="UTF-8"?>
<!--
  Class-schedule MCP server (port 8766).

  Do not edit the three placeholders by hand — deploy/install.sh fills in
  REPO_PATH, NPM_PATH, and HOME_PATH and installs this file. It is checked in
  as a template so the substitution is reviewable.

  BIND: loopback. Campus reachability comes from the reverse proxy in front
  (deploy/Caddyfile.example), never from binding this process to 0.0.0.0. The
  MCP HTTP transport performs no Host/Origin validation, so off loopback the
  bearer token would be the only gate.

  AUTH: the bearer lives in the repo's gitignored .env. Never write a token
  into this file — it is world-readable and it is in git.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>edu.clemson.advising-mcp.schedule</string>

  <key>ProgramArguments</key>
  <array>
    <string>NPM_PATH</string>
    <string>run</string>
    <string>mcp:schedule:http</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Trust OpenSSL's CA bundle (Homebrew openssl@3/cert.pem), not Node's
         compiled-in roots. 2026-10-21: node 22.22.2's bundled store still
         trusts the compromised "emSign ECC Root CA - G3" (removed upstream
         in 22.23.4); the Homebrew bundle does not. Drop this once node@22
         is at 22.23.4 or later. -->
    <key>NODE_OPTIONS</key>
    <string>--use-openssl-ca</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>HOME_PATH</string>
    <key>LOG_FILE</key>
    <string>HOME_PATH/Library/Logs/advising-mcp.schedule.log</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>HOME_PATH/Library/Logs/advising-mcp.schedule.out.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/Library/Logs/advising-mcp.schedule.err.log</string>
</dict>
</plist>
